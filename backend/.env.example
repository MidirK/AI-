# 데이터베이스 접속 정보
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aicom

# JWT 설정
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS 허용 origin (콤마로 구분)
CORS_ORIGINS=http://localhost:5173

# 회원가입 허용 이메일 도메인 (콤마로 구분, 비워두면 전체 허용 - 로컬 개발용)
# 운영 배포 시 학교 이메일 도메인으로 채운다. 예: ALLOWED_EMAIL_DOMAINS=ai.university.ac.kr
ALLOWED_EMAIL_DOMAINS=
